@page "/verificar-correo"
@attribute [Authorize]
@layout AutenticacionLayout
@using System.Net
@using TiendaCry.Mobile.Services
@inject AutenticacionService AutenticacionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider EstadoAutenticacion

<PageTitle>Verificá tu correo</PageTitle>

<MudStack Spacing="6">
    <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">
        Verificá tu correo
    </MudText>

    <MudText Align="Align.Center">
        Para continuar, confirmá tu dirección desde el link del correo.
        Después volvé a la app.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <MudAlert Severity="Severity.Info">
            @_mensaje
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">
            @_error
        </MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Disabled="_procesando"
               OnClick="EnviarCorreo">
        Enviar o reenviar correo
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               FullWidth="true"
               Disabled="_procesando"
               OnClick="@(() => ComprobarVerificacion(true))">
        Ya verifiqué mi correo
    </MudButton>

    <MudButton Href="/modificar-correo"
               FullWidth="true"
               Disabled="_procesando">
        Modificar correo
    </MudButton>

    <BotonCerrarSesion />
</MudStack>

@code {
    private bool _procesando;
    private string? _mensaje;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ComprobarVerificacion(false);
    }

    private async Task ComprobarVerificacion(bool renovarSesion)
    {
        if (_procesando)
        {
            return;
        }

        _procesando = true;
        _error = null;
        _mensaje = null;

        try
        {
            if (renovarSesion)
            {
                await AutenticacionService.RenovarSesion();
            }

            AuthenticationState estado = await EstadoAutenticacion.GetAuthenticationStateAsync();

            if (estado.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (ClaimsUsuario.TieneEmailVerificado(estado.User))
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _mensaje = "Tu correo todavía no está verificado.";
            }
        }
        catch (HttpRequestException e)
        {
            MostrarError(e);
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task EnviarCorreo()
    {
        if (_procesando)
        {
            return;
        }

        _procesando = true;
        _error = null;
        _mensaje = null;

        try
        {
            await AutenticacionService.EnviarVerificacionEmail();

            _mensaje = "Se envió el correo de verificación. Abrí el link recibido.";
        }
        catch (HttpRequestException e)
        {
            MostrarError(e);
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private void MostrarError(HttpRequestException e)
    {
        if (e.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            _error = "No se pudo completar la solicitud. Intentá nuevamente.";
        }
    }
}
