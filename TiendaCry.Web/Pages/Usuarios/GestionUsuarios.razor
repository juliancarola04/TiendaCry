@page "/administracion/usuarios"
@attribute [Authorize(Roles = RolesUsuario.AdministradorTiendaCry)]
@layout MainLayout
@using System.Net
@using TiendaCry.Shared.DTO.Usuario.Response
@using TiendaCry.Web.Services
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Gestión de usuarios</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudStack Spacing="4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" HtmlTag="h1">Gestión de usuarios</MudText>

            <MudTooltip Text="Añadir usuario">
                <MudIconButton Href="/administracion/usuarios/agregar"
                               Icon="@Icons.Material.Filled.Add"
                               Color="Color.Primary"
                               aria-label="Añadir usuario" />
            </MudTooltip>
        </MudStack>

        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
            <MudButton OnClick="CargarUsuarios" Color="Color.Primary">Reintentar</MudButton>
        }
        else
        {
            <MudTable T="UsuarioListadoResponse" Items="_usuarios" Hover="true">
                <HeaderContent>
                    <MudTh>Nombre y apellido</MudTh>
                    <MudTh>Correo</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate Context="usuario">
                    <MudTd DataLabel="Nombre y apellido">@usuario.Nombre @usuario.Apellido</MudTd>
                    <MudTd DataLabel="Correo">@usuario.Email</MudTd>
                    <MudTd DataLabel="Acciones">
                        <MudTooltip Text="Dar de baja al usuario">
                            <MudIconButton OnClick="() => DarDeBaja(usuario)"
                                           Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Error"
                                           Disabled="_procesando"
                                           aria-label="Dar de baja al usuario" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No hay usuarios activos.</MudText>
                </NoRecordsContent>
            </MudTable>
        }

        <MudButton Href="/">Volver al inicio</MudButton>
    </MudStack>
</MudContainer>

@code {
    private List<UsuarioListadoResponse> _usuarios = new List<UsuarioListadoResponse>();
    private bool _cargando = true;
    private bool _procesando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task DarDeBaja(UsuarioListadoResponse usuario)
    {
        if (_procesando)
        {
            return;
        }

        _procesando = true;

        try
        {
            bool? confirmada = await DialogService.ShowMessageBoxAsync(
                "Dar de baja al usuario",
                $"¿Querés dar de baja a «{usuario.Nombre} {usuario.Apellido}»? Se bloqueará su acceso y se revocarán sus sesiones. También se darán de baja sus vinculaciones y las tiendas que administre, junto con las vinculaciones y promociones pendientes o aprobadas de esas tiendas. El historial se conservará.",
                yesText: "Dar de baja",
                cancelText: "Cancelar");

            if (confirmada != true)
            {
                return;
            }

            _error = null;

            await UsuarioService.DarDeBaja(usuario.Id);

            _usuarios.RemoveAll(u => u.Id == usuario.Id);
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else if (e.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "No tenés permiso para dar de baja a este usuario.";
            }
            else if (e.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "El usuario no existe, ya está dado de baja o es administrador de TiendaCry.";
            }
            else if (e.StatusCode is null)
            {
                _error = "No se pudo conectar con el servidor.";
            }
            else
            {
                _error = "No se pudo dar de baja al usuario.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task CargarUsuarios()
    {
        _cargando = true;
        _error = null;

        try
        {
            _usuarios = await UsuarioService.ObtenerUsuarios();
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else if (e.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "No tenés permiso para gestionar usuarios.";
            }
            else if (e.StatusCode is null)
            {
                _error = "No se pudo conectar con el servidor.";
            }
            else
            {
                _error = "No se pudieron obtener los usuarios.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
