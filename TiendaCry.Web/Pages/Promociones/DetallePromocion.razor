@page "/tiendas/{IdTienda:int}/promociones/{IdPromocion:int}/detalles"
@attribute [Authorize(Roles = RolesUsuario.AdministradorTienda + "," + RolesUsuario.AdministradorTiendaCry)]
@layout MainLayout
@using System.Net
@using TiendaCry.Shared.DTO.Promocion.Response
@using TiendaCry.Web.Services
@inject PromocionService PromocionService
@inject NavigationManager Navigation

<PageTitle>Detalles de la promoción</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">
            Detalles de la promoción
        </MudText>

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
            <MudButton OnClick="CargarDetalle" Color="Color.Primary">Reintentar</MudButton>
        }
        else if (_detalle is not null)
        {
            <DatosPromocion Detalle="_detalle" />
        }

        <AuthorizeView Roles="@RolesUsuario.AdministradorTiendaCry">
            <Authorized>
                <MudButton Href="@($"/administracion/promociones/tiendas/{IdTienda}")">Volver al listado</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="@($"/tiendas/{IdTienda}/promociones")">Volver al listado</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public int IdTienda { get; set; }

    [Parameter]
    public int IdPromocion { get; set; }

    private DetallePromocionResponse? _detalle;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        _cargando = true;
        _error = null;
        _detalle = null;

        try
        {
            _detalle = await PromocionService.ObtenerDetalle(IdTienda, IdPromocion);
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else if (e.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "No tenés permiso para consultar esta promoción.";
            }
            else if (e.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "La promoción no existe.";
            }
            else if (e.StatusCode is null)
            {
                _error = "No se pudo conectar con el servidor.";
            }
            else
            {
                _error = "No se pudieron obtener los detalles de la promoción.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
