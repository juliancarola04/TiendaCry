@page "/tiendas/{IdTienda:int}/promociones/{IdPromocion:int}/rechazo"
@attribute [Authorize(Roles = RolesUsuario.AdministradorTienda)]
@layout MainLayout
@using System.Net
@using TiendaCry.Shared.DTO.Promocion.Response
@using TiendaCry.Web.Services
@inject PromocionService PromocionService
@inject NavigationManager Navigation

<PageTitle>Motivo del rechazo</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5" HtmlTag="h1">Motivo del rechazo</MudText>

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
            <MudButton OnClick="CargarRechazo" Color="Color.Primary">Reintentar</MudButton>
        }
        else if (_rechazo is not null)
        {
            <MudText Typo="Typo.subtitle1">@_rechazo.Titulo</MudText>

            <MudTextField T="string"
                          Value="@(_rechazo.Motivo ?? "No se registró un motivo de rechazo.")"
                          Label="La promoción fue rechazada debido a"
                          Variant="Variant.Outlined"
                          Lines="6"
                          ReadOnly="true" />
        }

        <MudButton Href="@($"/tiendas/{IdTienda}/promociones")">Volver a promociones</MudButton>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public int IdTienda { get; set; }

    [Parameter]
    public int IdPromocion { get; set; }

    private RechazoPromocionResponse? _rechazo;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        await CargarRechazo();
    }

    private async Task CargarRechazo()
    {
        _cargando = true;
        _error = null;
        _rechazo = null;

        try
        {
            _rechazo = await PromocionService.ObtenerRechazo(IdTienda, IdPromocion);
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else if (e.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "No tenés permiso para consultar esta promoción.";
            }
            else if (e.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "La promoción no existe o ya no está rechazada.";
            }
            else if (e.StatusCode is null)
            {
                _error = "No se pudo conectar con el servidor.";
            }
            else
            {
                _error = "No se pudo obtener el motivo del rechazo.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
