@page "/"
@attribute [Authorize]
@layout MainLayout
@using System.Net
@using TiendaCry.Shared.DTO.Tienda.Response
@using TiendaCry.Web.Services
@inject TiendaService TiendaService
@inject AuthenticationStateProvider EstadoAutenticacion
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudStack Spacing="4">
        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">
                @_error
            </MudAlert>

            <MudButton OnClick="CargarInicio" Color="Color.Primary">
                Reintentar
            </MudButton>
        }
        else if (_esAdministradorTiendaCry)
        {
            <AuthorizeView Roles="@RolesUsuario.AdministradorTiendaCry">
                <Authorized>
                    <MudContainer MaxWidth="MaxWidth.Small">
                        <MudStack Spacing="5">
                            <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">
                                Panel de administrador
                            </MudText>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="true">
                                Gestionar administradores
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="true">
                                Gestionar usuarios
                            </MudButton>

                            <MudButton Href="/administracion/tiendas"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true">
                                Gestionar tiendas
                            </MudButton>

                            <MudButton Href="/administracion/promociones"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true">
                                Gestionar promociones
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="true">
                                Gestionar cupones
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="true">
                                Ver estadísticas de tiendas
                            </MudButton>
                        </MudStack>
                    </MudContainer>
                </Authorized>
            </AuthorizeView>
        }
        else if (_tiendaActiva is not null)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-6">
                <MudStack Spacing="8">
                    <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">
                        @_tiendaActiva.Nombre
                    </MudText>

                    <AuthorizeView Roles="@RolesUsuario.AdministradorTienda">
                        <Authorized>
                            <MudStack Spacing="6" Class="mt-6">
                                <MudButton Href="@($"/tiendas/{_tiendaActiva.Id}/promociones")"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true">
                                    Gestionar promociones
                                </MudButton>

                                <MudButton Href="@($"/tiendas/{_tiendaActiva.Id}/empleados")"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true">
                                    Gestionar empleados
                                </MudButton>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           FullWidth="true">
                                    Cancelar relaciones con TiendaCry
                                </MudButton>
                            </MudStack>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>
            </MudContainer>
        }
    </MudStack>
</MudContainer>

@code {
    private bool _cargando = true;
    private bool _esAdministradorTiendaCry;
    private TiendaActivaResponse? _tiendaActiva;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarInicio();
    }

    private async Task CargarInicio()
    {
        _cargando = true;
        _error = null;
        _tiendaActiva = null;
        _esAdministradorTiendaCry = false;

        try
        {
            AuthenticationState estado = await EstadoAutenticacion.GetAuthenticationStateAsync();

            if (estado.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login", replace: true);
                return;
            }

            _esAdministradorTiendaCry = estado.User.IsInRole(RolesUsuario.AdministradorTiendaCry);

            if (_esAdministradorTiendaCry)
            {
                return;
            }

            _tiendaActiva = await TiendaService.ObtenerTiendaActiva();

            if (_tiendaActiva is null)
            {
                Navigation.NavigateTo("/solicitudes-tiendas", replace: true);
            }
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login", replace: true);
            }
            else if (e.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = "No tenés permiso para consultar tu tienda activa.";
            }
            else if (e.StatusCode is null)
            {
                _error = "No se pudo conectar con el servidor.";
            }
            else
            {
                _error = "No se pudo cargar el inicio.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
