@inherits LayoutComponentBase
@using System.Net
@inject NavigationManager Navigation
@inject AuthenticationStateProvider EstadoAutenticacion

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_cargando)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudStack Spacing="3" Class="pa-6">
        <MudAlert Severity="Severity.Error">
            @_error
        </MudAlert>

        <MudButton OnClick="CargarSesion" Color="Color.Primary">
            Reintentar
        </MudButton>
    </MudStack>
}
else if (_autorizado)
{
    <div class="page">
        @*
        <div class="sidebar">
            <NavMenu/>
        </div>
        *@
        <main>
            <div class="top-row px-4">
                @*<a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>*@
                <BotonCerrarSesion/>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

@code {
    private bool _cargando = true;
    private bool _autorizado;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarSesion();
    }

    private async Task CargarSesion()
    {
        _cargando = true;
        _autorizado = false;
        _error = null;

        try
        {
            AuthenticationState estado = await EstadoAutenticacion.GetAuthenticationStateAsync();

            if (estado.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!ClaimsUsuario.TieneEmailVerificado(estado.User))
            {
                Navigation.NavigateTo("/verificar-correo");
                return;
            }

            _autorizado = true;
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                _error = "No se pudo recuperar la sesión. Intentá nuevamente.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
